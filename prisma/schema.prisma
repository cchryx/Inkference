// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

////////// AUTH //////////
model Session {
  id        String   @id @default(uuid())
  createdAt DateTime
  updatedAt DateTime

  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id        String   @id @default(uuid())
  createdAt DateTime
  updatedAt DateTime

  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id        String    @id @default(uuid())
  createdAt DateTime?
  updatedAt DateTime?

  identifier String
  value      String
  expiresAt  DateTime

  @@map("verifications")
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name          String
  nameUpdatedAt DateTime?

  email          String    @unique
  emailVerified  Boolean
  emailUpdatedAt DateTime?

  username          String?   @unique
  displayUsername   String?   @unique
  usernameUpdatedAt DateTime?

  phoneNumber          BigInt?   @unique
  phoneNumberUpdatedAt DateTime?

  image          String?
  imageUpdatedAt DateTime?

  // Admin tools: "user" or "admin". A ban lasts until bannedUntil.
  role        String    @default("user") @db.VarChar(10)
  bannedUntil DateTime?
  banReason   String?   @db.VarChar(500)

  // Extra photo storage an admin gave this person (on top of everyone's limit).
  storageExtraMB   Int     @default(0)
  storageUnlimited Boolean @default(false)

  sessions Session[]
  accounts Account[]

  Profile       Profile?
  UserData      UserData?
  Relationships Relationships?
  PrivacySettings PrivacySettings?
  DriveFiles      DriveFile[]

  @@map("users")
}

model Profile {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bannerImage          String?
  bannerImageUpdatedAt DateTime?

  bio          String?   @db.VarChar(800)
  bioUpdatedAt DateTime?

  birthdate          Int?
  birthdateUpdatedAt DateTime?

  address          String?
  addressUpdatedAt DateTime?

  socialLinks          String[]  @db.VarChar(255)
  socialLinksUpdatedAt DateTime?

  // Resume (a PDF in Cloudinary: <userId>/resume/...), shown on the profile.
  resumeUrl       String?
  resumeName      String?   @db.VarChar(120)
  resumeUpdatedAt DateTime?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profile")
}

model UserData {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects              Project[]
  projectsContributedTo Project[] @relation("ProjectContributors")
  projectsLiked         Project[] @relation("ProjectLikes")
  projectsViewed        Project[] @relation("ProjectViews")
  projectsSaved         Project[] @relation("ProjectSaves")

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  experiences Experience[]
  educations  Education[]
  merits      Merit[]
  posts       Post[]
  skills      Skill[]      @relation("UserSkills")
  galleries   Gallery[]

  postsLiked  Post[] @relation("PostLikes")
  postsViewed Post[] @relation("PostViews")
  postsSaved  Post[] @relation("PostSaves")

  comments Comment[]

  @@map("userData")
}

model ProjectGalleryImage {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  image       String
  description String? @db.VarChar(500)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_gallery_images")
}

enum ProjectStatus {
  IN_PROGRESS
  COMPLETE
}

model Project {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String  @db.VarChar(80)
  summary     String? @db.VarChar(200)
  description String? @db.VarChar(5000)

  projectLinks     String[] @db.VarChar(255)
  projectResources String[] @db.VarChar(255)

  iconImage   String?
  bannerImage String?

  status    ProjectStatus
  startDate DateTime?
  endDate   DateTime?

  contributors UserData[] @relation("ProjectContributors")

  views UserData[] @relation("ProjectViews")
  likes UserData[] @relation("ProjectLikes")
  saves UserData[] @relation("ProjectSaves")

  // Who can see it. DEFAULT = use the owner's default from Settings.
  // PUBLIC | FOLLOWERS | FRIENDS | CUSTOM (only allowedUserIds) | PRIVATE (only me)
  visibility        String   @default("DEFAULT") @db.VarChar(10)
  allowedUserIds    String[] @default([]) // for CUSTOM
  hiddenFromUserIds String[] @default([]) // these people can never see it
  hiddenAt          DateTime? // flagged by an admin: hidden from everyone else while under review

  galleryImages ProjectGalleryImage[]

  userDataId String
  userData   UserData @relation(fields: [userDataId], references: [id], onDelete: Cascade)
  skills     Skill[]  @relation("ProjectSkills")

  @@index([userDataId, updatedAt])
  @@map("projects")
}

model Relationships {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isPrivate Boolean @default(false)

  following Relationships[] @relation("UserFollows")
  followers Relationships[] @relation("UserFollows")

  friends  Relationships[] @relation("UserFriends")
  friendOf Relationships[] @relation("UserFriends")

  blockedUsers Relationships[] @relation("UserBlocks")
  blockedBy    Relationships[] @relation("UserBlocks")

  followRequestsSent     Relationships[] @relation("FollowRequests")
  followRequestsReceived Relationships[] @relation("FollowRequests")

  friendRequestsSent     Relationships[] @relation("FriendRequests")
  friendRequestsReceived Relationships[] @relation("FriendRequests")

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("relationships")
}

model Experience {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title        String @db.VarChar(60)
  organization String @db.VarChar(100)
  description  String @db.Text

  startDate DateTime
  endDate   DateTime?
  status    String

  location       String @db.VarChar(100)
  locationType   String
  employmentType String

  userDataId String
  userData   UserData @relation(fields: [userDataId], references: [id], onDelete: Cascade)
  skills     Skill[]  @relation("ExperienceSkills")

  @@index([userDataId, updatedAt])
  @@map("experiences")
}

model Education {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userDataId String
  userData   UserData @relation(fields: [userDataId], references: [id], onDelete: Cascade)

  degree                 String
  fieldOfStudy           String
  school                 String
  activitiesAndSocieties String

  startDate DateTime
  endDate   DateTime

  @@index([userDataId, updatedAt])
  @@map("educations")
}

model Merit {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userDataId String
  userData   UserData @relation(fields: [userDataId], references: [id], onDelete: Cascade)

  title     String @db.VarChar(100)
  issuer    String @db.VarChar(100)
  meritType String @db.VarChar(50)
  summary   String @db.Text

  issueDate  DateTime?
  expiryDate DateTime?

  image String @db.VarChar(255)

  @@index([userDataId, updatedAt])
  @@map("merits")
}

model Post {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userDataId String
  userData   UserData @relation(fields: [userDataId], references: [id], onDelete: Cascade)

  type   String @db.VarChar(50)
  dataId String

  content     String[]
  description String?  @db.VarChar(2200)
  location    String?
  mentions    String[]
  tags        String[]

  views UserData[] @relation("PostViews")
  likes UserData[] @relation("PostLikes")
  saves UserData[] @relation("PostSaves")

  // Who can see it. DEFAULT = use the owner's default from Settings.
  // PUBLIC | FOLLOWERS | FRIENDS | CUSTOM (only allowedUserIds) | PRIVATE (only me)
  visibility        String   @default("DEFAULT") @db.VarChar(10)
  allowedUserIds    String[] @default([]) // for CUSTOM
  hiddenFromUserIds String[] @default([]) // these people can never see it
  hiddenAt          DateTime? // flagged by an admin: hidden from everyone else while under review

  comments Comment[]

  @@index([userDataId, updatedAt])
  @@index([userDataId, createdAt]) // Following / Friends feed
  @@index([createdAt, id]) // For You feed (keyset pagination)
  @@map("posts")
}

model Skill {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       UserData[]   @relation("UserSkills")
  projects    Project[]    @relation("ProjectSkills")
  experiences Experience[] @relation("ExperienceSkills")

  name      String  @unique @db.VarChar(60)
  iconImage String?

  @@map("skills")
}

model Gallery {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String   @db.VarChar(100)

  userDataId String
  userData   UserData @relation(fields: [userDataId], references: [id], onDelete: Cascade)

  photos Photo[]

  // Who can see it. DEFAULT = use the owner's default from Settings.
  // PUBLIC | FOLLOWERS | FRIENDS | CUSTOM (only allowedUserIds) | PRIVATE (only me)
  visibility        String   @default("DEFAULT") @db.VarChar(10)
  allowedUserIds    String[] @default([]) // for CUSTOM
  hiddenFromUserIds String[] @default([]) // these people can never see it
  hiddenAt          DateTime? // flagged by an admin: hidden from everyone else while under review

  @@map("galleries")
}

model Photo {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  galleryId String
  gallery   Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  image String

  hiddenAt DateTime? // flagged by an admin: hidden while under review

  @@map("photos")
}

////////// TRENDING //////////
// One row per person, per action, per item, per day. Used to find what's
// hot right now (likes/views/saves in the last 24 hours or 7 days).
model Engagement {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  day       DateTime @db.Date

  kind       String @db.VarChar(10) // "view" | "like" | "save" | "comment"
  targetType String @db.VarChar(10) // "post" | "project"
  targetId   String
  userDataId String

  @@unique([kind, targetType, targetId, userDataId, day])
  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("engagements")
}

////////// COMMENTS //////////
model Comment {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  text String @db.VarChar(1000)

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userDataId String
  userData   UserData @relation(fields: [userDataId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("comments")
}

////////// NOTIFICATIONS //////////
// One row per "group" for a person, e.g. all new likes on one post.
// New activity updates the row ("Sam and 4 others liked your post")
// instead of creating a row per like.
model Notification {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipientId String // User.id of who gets it
  type        String  @db.VarChar(30) // like | comment | follow | friend_request | friend_accept | friend_post | friend_project | views
  groupKey    String  @db.VarChar(120) // e.g. "like:post:<id>"
  targetType  String? @db.VarChar(10) // post | project
  targetId    String?

  actorIds   String[] @default([]) // most recent people first (up to 3)
  actorCount Int      @default(1) // how many people in total
  preview    String?  @db.VarChar(200) // e.g. the latest comment
  read       Boolean  @default(false)

  @@unique([recipientId, groupKey])
  @@index([recipientId, updatedAt])
  @@index([recipientId, read])
  @@map("notifications")
}

////////// PRIVACY //////////
model PrivacySettings {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Default audience for posts, projects and galleries:
  // PUBLIC | FOLLOWERS | FRIENDS | PRIVATE
  defaultVisibility String   @default("PUBLIC") @db.VarChar(10)
  // People who can't see ANY of your posts, projects or galleries.
  hiddenFrom        String[] @default([])

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("privacy_settings")
}

// Which notifications someone wants. Everything is on unless listed here.
model NotificationSettings {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inAppOff String[] @default([]) // types not shown in the Inbox at all
  pushOff  String[] @default([]) // types not sent to the phone/computer

  userId String @unique

  @@map("notification_settings")
}

// A device that agreed to receive push notifications (phone PWA, browser).
model PushSubscription {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId    String
  endpoint  String  @unique
  p256dh    String
  auth      String
  userAgent String? @db.VarChar(300)

  @@index([userId])
  @@map("push_subscriptions")
}

// A file in someone's Drive. One table for every kind of file, so new kinds
// (docs, sheets, to-dos) can be added later without a new table.
//   type "note":    content = { text }
//   type "planner": content = { color, labels[], lists[{ cards[] }] }  (Trello-style board)
// Private to the owner for now.
model DriveFile {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String
  title   String  @default("") @db.VarChar(200)
  content Json    @default("{}")
  pinned  Boolean @default(false)

  reminders DriveReminder[]

  @@index([userId, type, updatedAt])
  @@map("drive_files")
}

// A reminder someone set on a planner card or to-do. The card/to-do itself
// lives in DriveFile.content; this row is just so the reminder job can find
// what's due quickly. Kept in sync every time the file is saved.
model DriveReminder {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId String
  fileId String
  file   DriveFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  itemId   String    @db.VarChar(40)
  title    String    @db.VarChar(200)
  due      String    @db.VarChar(10) // "YYYY-MM-DD"
  time     String?   @db.VarChar(5) // "HH:MM"
  remindAt DateTime
  sentAt   DateTime?

  @@unique([fileId, itemId])
  @@index([sentAt, remindAt])
  @@index([userId])
  @@map("drive_reminders")
}

// Small per-person app preferences (e.g. the planner view you used last).
// Stored as JSON so new preferences don't need a new column.
model UserPreference {
  id        String   @id @default(uuid())
  updatedAt DateTime @updatedAt

  userId String @unique
  data   Json   @default("{}")

  @@map("user_preferences")
}

// ---------- Tips ("Buy me a coffee") ----------
// Written so the payment company can change later (e.g. our own system):
// `provider` says who handled it, `externalId` is their id for it.

// Where someone gets paid (their account with the payment provider).
model PayoutAccount {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId     String @unique
  provider   String // "stripe" for now
  externalId String @unique // e.g. the Stripe connected account id (acct_...)

  // Filled in from the provider:
  canReceive  Boolean @default(false) // can take payments
  canPayout   Boolean @default(false) // can send money to their bank
  setupDone   Boolean @default(false) // finished the provider's sign-up
  country     String?
  currency    String?

  // Their own switch: show the coffee button on their profile.
  tipsEnabled Boolean @default(true)

  @@map("payout_accounts")
}

// One coffee someone bought for someone else.
model Tip {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider   String
  externalId String? @unique // e.g. the Stripe Checkout session id

  fromUserId String? // null if the supporter's account was deleted
  toUserId   String

  // Money, in cents (smallest unit) of `currency`:
  amount        Int // the coffee price the supporter picked
  processingFee Int // card processing, paid by the supporter
  platformFee   Int // Inkference's cut
  total         Int // what the supporter's card is charged
  toRecipient   Int // what the recipient gets
  currency      String

  message String? @db.VarChar(200)
  status  String  @default("pending") // pending | paid | failed | refunded
  paidAt  DateTime?

  @@index([toUserId, status, createdAt])
  @@index([fromUserId, createdAt])
  @@map("tips")
}

// Every file someone uploaded to our image storage (Cloudinary), with its
// size, so we can show usage and keep everyone under a fair limit.
model StoredFile {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId   String
  url      String @unique
  publicId String
  bytes    Int
  kind     String // posts | photos | projects | merits | profile

  @@index([userId])
  @@map("stored_files")
}

////////// MODERATION //////////
// Something an admin flagged or removed. Flagged items are hidden and get
// deleted when deleteAt passes, unless the owner appeals (then an admin decides).
model ModerationCase {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String // User.id of whose content it is
  adminId String? // User.id of the admin

  targetType String  @db.VarChar(20) // post | project | gallery | photo | post_photo | profile_image | banner | bio | comment
  targetId   String
  label      String  @db.VarChar(200) // what it was, in words
  image      String? // picture of it, for context

  reason     String    @db.VarChar(500)
  status     String    @default("flagged") @db.VarChar(12) // flagged | appealed | removed | restored
  appeal     String?   @db.VarChar(1000)
  appealedAt DateTime?
  deleteAt   DateTime?
  resolvedAt DateTime?

  @@index([ownerId, createdAt])
  @@index([status, deleteAt])
  @@map("moderation_cases")
}

// App-wide settings admins can change (e.g. the storage limit).
model AppSetting {
  key       String   @id @db.VarChar(60)
  value     Json
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// Someone reported a post, project, gallery or photo. Admins review these.
model Report {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  reporterId String // User.id
  ownerId    String // User.id of whose content it is
  targetType String @db.VarChar(20) // post | project | gallery | photo
  targetId   String

  reason  String  @db.VarChar(40)
  details String? @db.VarChar(500)

  status     String    @default("open") @db.VarChar(12) // open | resolved | dismissed
  resolvedBy String?
  resolvedAt DateTime?

  @@unique([reporterId, targetType, targetId]) // one report per person per thing
  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}
